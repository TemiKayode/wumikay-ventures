{
  "name": "wumikay-server",
  "version": "1.0.0",
  "description": "WumiKay Ventures - Server Application",
  "author": "WumiKay Ventures",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "build": "electron-builder --win",
    "build:portable": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^40.0.0",
    "electron-builder": "^26.4.0"
  },
  "build": {
    "appId": "com.wumikay.server",
    "productName": "WumiKay Server",
    "directories": {
      "output": "../dist-server"
    },
    "npmRebuild": false,
    "asar": true,
    "files": [
      "main.js",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../server-bundle",
        "to": "server-bundle",
        "filter": ["**/*"]
      },
      {
        "from": "../public/logo.png",
        "to": "logo.png"
      }
    ],
    "win": {
      "target": [
        {
          "target": "portable",
          "arch": ["x64"]
        }
      ],
      "icon": "../public/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "portable": {
      "artifactName": "WumiKay-Server.exe"
    }
  }
}
